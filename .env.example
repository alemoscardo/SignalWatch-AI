# Optional fallback for CLI evaluation and local development. The browser can
# accept a temporary OpenRouter key without changing this file.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports the required tool calls.
OPENROUTER_MODEL=openrouter/free
# Choose a local database password. Use the same password in DATABASE_URL.
SIGNALWATCH_DB_PASSWORD=
DATABASE_URL=postgresql://signalwatch:YOUR_PASSWORD@127.0.0.1:55432/signalwatch
# Downloaded explicitly by signalwatch-db encoder-setup.
SIGNALWATCH_ENCODER_PATH=data/local/encoder
# Use semantic normally; lexical avoids local PyTorch when Windows blocks its DLLs.
SIGNALWATCH_RETRIEVAL_MODE=semantic
